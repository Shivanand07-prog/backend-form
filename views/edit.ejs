<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Post</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <a
            href="/profile"
            class="text-blue-500 mb-5 inline-block"
        >
            Back to Profile
        </a>

        <h3 class="text-3xl mb-5">
            Edit your post.
        </h3>

        <form
            action="/update/<%= post._id %>"
            method="post"
        >

            <textarea
                name="content"
                class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md"
            ><%= post.content %></textarea>

            <input
                class="px-5 py-2 bg-yellow-500 text-black rounded-md mt-3"
                type="submit"
                value="Update Post"
            >

        </form>

    </div>

</body>

</html>