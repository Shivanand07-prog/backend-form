<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Profile</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <!-- Logout -->

        <a
            href="/logout"
            class="bg-red-500 rounded-md px-3 py-2 text-sm mb-5 inline-block"
        >
            Logout
        </a>


        <!-- Welcome -->

        <h3 class="text-3xl mt-5">
            <span class="font-light">Hello</span>,
            <%= user.name %> 👋
        </h3>

        <h5 class="mb-5">
            You can create a new post.
        </h5>


        <!-- Create Post -->

        <form
            method="post"
            action="/post"
        >

            <textarea
                name="content"
                placeholder="What's on your mind?"
                class="block p-3 outline-none w-1/3 resize-none bg-transparent border-2 border-zinc-800 rounded-md"
            ></textarea>

            <input
                class="px-3 w-40 py-2 text-sm bg-blue-500 block rounded-md mt-2 cursor-pointer"
                type="submit"
                value="Create New Post"
            >

        </form>


        <!-- Posts -->

        <div class="posts mt-20">

            <h3 class="text-zinc-400">
                Your Posts
            </h3>

            <div class="postcontainer mt-5">

                <% user.posts.reverse().forEach(function(post) { %>

                    <div
                        class="post w-1/3 p-4 mb-4 rounded-md border-[1px] border-zinc-700 bg-zinc-800"
                    >

                        <!-- Username -->

                        <h4 class="text-blue-500 mb-2">
                            @<%= user.username %>
                        </h4>


                        <!-- Post Content -->

                        <p class="text-sm tracking-tight">
                            <%= post.content %>
                        </p>


                        <!-- Like Count -->

                        <small class="mt-2 inline-block text-zinc-400">
                            <%= post.likes.length %> likes
                        </small>


                        <!-- Buttons -->

                        <div class="btns flex gap-4 mt-2">

                            <% if (post.likes.indexOf(user._id) === -1) { %>

                                <!-- Like -->

                                <a
                                    class="text-blue-500"
                                    href="/like/<%= post._id %>"
                                >
                                    Like
                                </a>

                            <% } else { %>

                                <!-- Unlike -->

                                <a
                                    class="text-red-500"
                                    href="/like/<%= post._id %>"
                                >
                                    Unlike
                                </a>

                            <% } %>


                            <!-- Edit -->

                            <a
                                class="text-zinc-500"
                                href="/edit/<%= post._id %>"
                            >
                                Edit
                            </a>

                        </div>

                    </div>

                <% }) %>

            </div>

        </div>

    </div>

</body>

</html>