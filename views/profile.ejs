<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Profile</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <h1 class="text-4xl mb-5">
            Welcome, <%= user.name %>
        </h1>

        <div class="text-lg">

            <p>
                Username:
                <%= user.username %>
            </p>

            <p>
                Email:
                <%= user.email %>
            </p>

            <p>
                Age:
                <%= user.age %>
            </p>

        </div>

        <a
            href="/logout"
            class="text-red-500 mt-10 inline-block"
        >
            Logout
        </a>

    </div>

</body>

</html>