<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Profile</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">

        <!-- Logout -->
        <a
            href="/logout"
            class="bg-red-500 px-5 py-2 rounded-md"
        >
            Logout
        </a>


        <!-- User Information -->

        <h1 class="text-3xl mt-10">
            Hello, <%= user.name %> 👋
        </h1>

        <p class="text-zinc-400 mt-2">
            You can create a new post.
        </p>


        <!-- CREATE POST -->

        <form action="/post" method="post" class="mt-5">

            <textarea
                name="content"
                placeholder="What's on your mind?"
                class="w-96 h-32 p-3 bg-transparent border-2 border-zinc-700 rounded-md outline-none"
            ></textarea>

            <br>

            <input
                type="submit"
                value="Create New Post"
                class="mt-3 px-5 py-2 bg-blue-500 rounded-md cursor-pointer"
            >

        </form>


        <!-- USER DETAILS -->

        <div class="mt-10">

            <h2 class="text-xl">
                Your Details
            </h2>

            <p class="text-zinc-400 mt-2">
                Username: <%= user.username %>
            </p>

            <p class="text-zinc-400">
                Email: <%= user.email %>
            </p>

            <p class="text-zinc-400">
                Age: <%= user.age %>
            </p>

        </div>


        <!-- POSTS -->

        <h2 class="text-xl mt-10">
            Your Posts
        </h2>


        <div class="mt-5 w-96">

            <% user.posts.forEach(function(post) { %>

                <div class="bg-zinc-800 border border-zinc-700 rounded-md p-5 mb-4">

                    <p class="text-white">
                        <%= post.content %>
                    </p>

                    <div class="flex gap-5 mt-5">

                        <button class="text-blue-500">
                            Like
                        </button>

                        <button class="text-zinc-500">
                            Edit
                        </button>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</body>

</html>